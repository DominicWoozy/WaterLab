index 0000000..1d8f44e
--- /dev/null
+++ b/app/webgpu/macrocell-shaders.ts
@@ -0,0 +1,49 @@
+// Conservative bounds of 4x4x4 trilinear cells (5x5x5 supporting nodes).
+export const MACRO_COUNT = 32 * 40 * 24;
+export const macrocellBuild = /* wgsl */ `
+@group(0) @binding(0) var<storage,read> field:array<f32>;
+@group(0) @binding(1) var<storage,read_write> ranges:array<vec2f>;
+@compute @workgroup_size(4,4,4) fn main(@builtin(global_invocation_id) id:vec3u){
+ if(any(id>=vec3u(32,40,24))){return;}
+ var low=1e30;var high=-1e30;
+ for(var z=0u;z<=4u;z++){for(var y=0u;y<=4u;y++){for(var x=0u;x<=4u;x++){
+  let at=min(id*4u+vec3u(x,y,z),vec3u(127,159,95));let d=field[at.x+128u*(at.y+160u*at.z)];
+  low=min(low,d);high=max(high,d);
+ }}}
+ let margin=1e-5*max(1.,max(abs(low),abs(high)));
+ ranges[1u+id.x+32u*(id.y+40u*id.z)]=vec2f(low-margin,high+margin);
+ if(all(id==vec3u(0))){ranges[0]=vec2f(1.,0.);}
+}
+`;
+export function macrocellTraversal(enabled=true){return /* wgsl */ `
+@group(0) @binding(15) var<storage,read> densityRanges:array<vec2f>;
+struct DensityGrid {cell:vec3i,step:vec3i,next:vec3f,delta:vec3f,enter:f32,leave:f32}
+fn beginDensityGrid(ro:vec3f,rd:vec3f,at:f32)->DensityGrid {
+ ${enabled ? '' : 'return DensityGrid(); /*'}
+ let unit=(VMAX-VMIN)/(VSIZE-1.)*4.;
+ let cell=vec3i(clamp(floor((ro+rd*at-VMIN)/unit),vec3f(0.),vec3f(31.,39.,23.)));
+ let step=select(vec3i(-1),vec3i(1),rd>=vec3f(0.));
+ let inv=1./select(vec3f(1e-8),rd,abs(rd)>vec3f(1e-8));
+ let face=VMIN+(vec3f(cell)+select(vec3f(0.),vec3f(1.),rd>=vec3f(0.)))*unit;
+ let next=select(vec3f(1e5),(face-ro)*inv,abs(rd)>vec3f(1e-8));
+ let a=(vec3f(-1.86,-.96,-1.36)-ro)*inv;let b=(vec3f(1.86,volumeTop,1.36)-ro)*inv;
+ let lo=min(a,b);let hi=max(a,b);
+ return DensityGrid(cell,step,next,abs(unit*inv),max(lo.x,max(lo.y,lo.z)),min(hi.x,min(hi.y,hi.z)));
+ ${enabled ? '' : '*/'}
+}
+fn advanceDensityGrid(input:DensityGrid,at:f32)->DensityGrid {
+ var grid=input;
+ // Fine steps are smaller than one macrocell along every axis.
+ for(var axis=0;axis<3;axis++){if(at>=grid.next[axis]){grid.cell[axis]+=grid.step[axis];grid.next[axis]+=grid.delta[axis];}}
+ return grid;
+}
+fn gridRegion(grid:DensityGrid,at:f32,inside:bool,threshold:f32)->vec2f {
+ ${enabled ? '' : 'return vec2f(at,0.); /*'}
+ if(densityRanges[0].x!=1. || any(grid.cell<vec3i(0)) || any(grid.cell>=vec3i(32,40,24))){return vec2f(at,0.);}
+ let end=min(grid.leave,min(grid.next.x,min(grid.next.y,grid.next.z)));
+ if(at<=grid.enter || at>=grid.leave){return vec2f(at,0.);}
+ let cell=vec3u(grid.cell);let span=densityRanges[1u+cell.x+32u*(cell.y+40u*cell.z)];
+ return vec2f(end,select(0.,1.,select((span.y<threshold),(span.x>threshold),inside)));
+ ${enabled ? '' : '*/'}
+}
+`;}
