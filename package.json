{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:pages": "vite build --config vite.pages.config.ts",
    "test:gpu": "node --test tests/gpu-fluid.test.mjs",
    "test:webgpu": "node --experimental-strip-types tests/webgpu-numeric.mjs",
    "benchmark:webgpu": "node --experimental-strip-types tests/webgpu-benchmark.mjs",
    "test:webgpu:details": "node --experimental-strip-types tests/webgpu-details.mjs",
    "test:presentation": "node --test tests/webgpu-presentation.test.mjs",
    "test:webgpu:surface": "node --experimental-strip-types tests/webgpu-surface.mjs",
    "test:webgpu:settling": "node --experimental-strip-types tests/webgpu-settling.mjs",
    "test:webgpu:high-quality": "node --experimental-strip-types tests/webgpu-high-quality.mjs",
    "test:webgpu:neighbors": "node --experimental-strip-types tests/webgpu-neighbors.mjs",
    "test:webgpu:volume-reuse": "node --experimental-strip-types tests/webgpu-volume-reuse.mjs",
    "test:webgpu:shading": "node --experimental-strip-types tests/webgpu-shading.mjs",
    "test:webgpu:wall-contact": "node --experimental-strip-types tests/webgpu-wall-contact.mjs",
    "test:webgpu:self-optics": "node --experimental-strip-types tests/webgpu-self-optics.mjs && node --experimental-strip-types tests/webgpu-self-optics-images.mjs",
    "test:webgpu:refraction": "node --experimental-strip-types tests/webgpu-refraction.mjs",
    "test:webgpu:caustics": "node --experimental-strip-types tests/webgpu-caustics.mjs",
    "test:webgpu:invariants": "node --experimental-strip-types tests/webgpu-invariants.mjs",
    "test:webgpu:caustic-map": "node --experimental-strip-types tests/webgpu-caustic-map.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@webgpu/types": "^0.1.72",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "webgpu": "^0.6.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
